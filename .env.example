# VITA configuration
#
# Copy this file to `.env` and fill in the key. `.env` is gitignored and must
# never be committed.
#
#     cp .env.example .env

# --- required for language understanding -------------------------------
# Gemini API key. Used for both the LLM calls and the embeddings
# (gemini-embedding-001). Get one at https://aistudio.google.com/apikey
#
# The application starts without it. In that state language understanding is
# unavailable, the interface reports OFFLINE, and every case is escalated for
# human review rather than triaged on incomplete extraction.
GEMINI_API_KEY=

# --- optional overrides -------------------------------------------------
# Only set these if you have a reason to. The defaults are what the app ships
# with and what it is tested against.
# VITA_GEMINI_MODEL=gemini-flash-lite-latest
# VITA_EMBEDDING_MODEL=gemini-embedding-001

# --- outbound notification ----------------------------------------------
# Clinician notification is DRY RUN unless this is explicitly true. In dry run
# the full message is composed, recorded and shown in the hospital dashboard,
# but nothing is sent and nothing leaves the process. Turning it on is a
# deliberate act and requires the SMTP settings below.
# VITA_NOTIFY_ENABLED=false

# SMTP details, used only when VITA_NOTIFY_ENABLED is true.
# The recipient is configuration and never comes from model output or patient
# input - there is no code path that reads an address from either.
# VITA_SMTP_HOST=smtp.gmail.com
# VITA_SMTP_PORT=587
# VITA_SMTP_USER=
# VITA_SMTP_PASSWORD=
# VITA_NOTIFY_FROM=
# VITA_NOTIFY_TO=
